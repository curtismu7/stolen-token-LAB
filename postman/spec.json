{
  "name": "Stolen Token LAB",
  "slug": "stolen-token-lab",
  "description": "API collection for Stolen Token LAB: run the attack-gallery scenarios against the lab's mock authorization server and gateway (bearer replay, tampering, theft across surfaces and the defences that catch them), mutate a scenario's inputs, and run the safety scan. Everything is a labelled mock; the lab has no live mode.",
  "baseUrl": "http://localhost:4950",
  "env": {},
  "folders": [
    {
      "name": "Sanity (mock, labelled)",
      "description": "Health, mode info (always mock: every token, server and gateway is in-process), and the scenario catalog.",
      "requests": [
        { "name": "Health", "method": "GET", "path": "/api/health",
          "tests": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().state).to.eql('ready');"] },
        { "name": "Info (mode is mock by design)", "method": "GET", "path": "/api/info",
          "tests": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().mode).to.eql('mock');"] },
        { "name": "Scenario catalog", "method": "GET", "path": "/api/catalog",
          "tests": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().scenarios.length).to.be.above(0);"] },
        { "name": "Safety scan", "method": "GET", "path": "/api/safety-scan",
          "tests": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().ok).to.eql(true);"] }
      ]
    },
    {
      "name": "Run scenarios",
      "description": "One scenario per request (S01..: ids from the catalog), all at once, and a mutation of a scenario's inputs. Reset clears the run state.",
      "requests": [
        { "name": "Run S01 (bearer replay)", "method": "POST", "path": "/api/run",
          "body": { "scenario": "S01" },
          "tests": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().id).to.eql('S01');"] },
        { "name": "Run an unknown scenario (negative)", "method": "POST", "path": "/api/run",
          "body": { "scenario": "NOPE" },
          "tests": ["pm.expect(pm.response.code).to.eql(400);"] },
        { "name": "Run all scenarios", "method": "POST", "path": "/api/run-all",
          "body": {},
          "tests": ["pm.response.to.have.status(200);"] },
        { "name": "Mutate S01 (replay)", "method": "POST", "path": "/api/mutation",
          "body": { "scenario": "S01", "mutation": "replay" },
          "tests": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json()).to.have.property('blockedBy');"] },
        { "name": "Reset", "method": "POST", "path": "/api/reset",
          "body": {},
          "tests": ["pm.response.to.have.status(200);"] }
      ]
    }
  ]
}
