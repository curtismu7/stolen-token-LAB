      },
      {
        "op": "call",
        "id": "retry",
        "who": "client",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "DPoP",
        "proof": {
          "key": "client",
          "nonce": "learned"
        },
        "say": "It retries with the nonce from the DPoP-Nonce header.",
        "expect": {
          "status": 200
        }
      }
    ]
  },
