[
  {
    "id": "S01",
    "slug": "bearer-replay",
    "kind": "lesson",
    "title": "Bearer replay works",
    "defence": "none",
    "takeaway": "A plain bearer token is a bearer instrument: whoever holds it can use it. {{agent}} calls {{api_a}} fine, and a thief who copied the token does exactly the same. Nothing at the gateway can tell them apart.",
    "talk": "\"Whoever holds this token is the agent. The thief is no different to the gateway.\" This is the lesson; do not skip it.",
    "stolen": {
      "token": true,
      "proof": false,
      "key": false,
      "cert": false
    },
    "rfc": [
      "RFC 6750 1.2",
      "RFC 6750 5"
    ],
    "attackStep": "thief",
    "expect": {
      "status": 200
    },
    "blockedBy": null,
    "steps": [
      {
        "op": "issue",
        "id": "t1",
        "kind": "bearer",
        "holder": "client",
        "api": "a"
      },
      {
        "op": "call",
        "id": "legit",
        "who": "client",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "Bearer",
        "say": "{{agent}} reads {{asset}} with its token.",
        "expect": {
          "status": 200
        }
      },
      {
        "op": "call",
        "id": "thief",
        "who": "attacker",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "Bearer",
        "say": "The thief replays the captured token. It works. This is the lesson.",
        "expect": {
          "status": 200
        }
      }
    ]
  },
  {
    "id": "S02",
    "slug": "audience-binding",
    "kind": "attack",
    "title": "Audience binding stops replay at another API",
    "defence": "audience",
    "takeaway": "The token was minted for {{api_a}} (RFC 8707 resource, aud claim). Replayed at {{api_b}} it is refused. This stops token redirect, but not use at the right API.",
    "talk": "\"Good against the wrong API. Useless against the right one.\"",
    "stolen": {
      "token": true,
      "proof": false,
      "key": false,
      "cert": false
    },
    "rfc": [
      "RFC 8707 2, 3",
      "RFC 9700 2.3"
    ],
    "attackStep": "thief",
    "expect": {
      "status": 401,
      "error": "invalid_token"
    },
    "blockedBy": "audience",
    "steps": [
      {
        "op": "issue",
        "id": "t1",
        "kind": "bearer",
        "holder": "client",
        "api": "a"
      },
      {
        "op": "call",
        "id": "legit",
        "who": "client",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "Bearer",
        "say": "{{agent}} calls {{api_a}}.",
        "expect": {
          "status": 200
        }
      },
      {
        "op": "call",
        "id": "thief",
        "who": "attacker",
        "token": "t1",
        "api": "b",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "Bearer",
        "say": "The thief tries the same token at {{api_b}}.",
        "expect": {
          "status": 401,
          "error": "invalid_token"
        }
      }
    ]
  },
  {
    "id": "S03",
    "slug": "dpop-no-key",
    "kind": "attack",
    "title": "DPoP: the stolen token is useless without the key",
    "defence": "dpop_binding",
    "takeaway": "The token carries cnf.jkt, the thumbprint of {{agent}}'s key. The thief has the token but signs the proof with their own key, so the thumbprint does not match.",
    "talk": "\"Same token, valid proof, wrong key: the thumbprint in the token does not match.\"",
    "stolen": {
      "token": true,
      "proof": false,
      "key": false,
      "cert": false
    },
    "rfc": [
      "RFC 9449 6",
      "RFC 7638"
    ],
    "attackStep": "thief",
    "expect": {
      "status": 401,
      "error": "invalid_token"
    },
    "blockedBy": "dpop_binding",
    "steps": [
      {
        "op": "issue",
        "id": "t1",
        "kind": "dpop",
        "holder": "client",
        "api": "a"
      },
      {
        "op": "call",
        "id": "legit",
        "who": "client",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "DPoP",
        "proof": {
          "key": "client"
        },
        "say": "{{agent}} sends token plus a proof signed with its key.",
        "expect": {
          "status": 200
        }
      },
      {
        "op": "call",
        "id": "thief",
        "who": "attacker",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "DPoP",
        "proof": {
          "key": "attacker"
        },
        "say": "The thief signs a perfectly valid proof with their own key.",
        "expect": {
          "status": 401,
          "error": "invalid_token"
        }
      }
    ]
  },
  {
    "id": "S04",
    "slug": "dpop-downgrade",
    "kind": "attack",
    "title": "DPoP: no downgrade to Bearer",
    "defence": "dpop_binding",
    "takeaway": "The thief drops the proof and sends the DPoP-bound token as a plain Bearer. A gateway that honours cnf.jkt refuses it; one that ignores cnf treats it as a bearer token.",
    "talk": "\"Drop the proof, say Bearer. A gateway must honour `cnf`, or DPoP is decoration.\"",
    "stolen": {
      "token": true,
      "proof": false,
      "key": false,
      "cert": false
    },
    "rfc": [
      "RFC 9449 7.1"
    ],
    "attackStep": "thief",
    "expect": {
      "status": 401,
      "error": "invalid_token"
    },
    "blockedBy": "dpop_binding",
    "steps": [
      {
        "op": "issue",
        "id": "t1",
        "kind": "dpop",
        "holder": "client",
        "api": "a"
      },
      {
        "op": "call",
        "id": "thief",
        "who": "attacker",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "Bearer",
        "say": "Token only, as Authorization: Bearer.",
        "expect": {
          "status": 401,
          "error": "invalid_token"
        }
      }
    ]
  },
  {
    "id": "S05",
    "slug": "dpop-proof-replay",
    "kind": "attack",
    "title": "DPoP: a replayed proof (same jti) is refused",
    "defence": "dpop_jti",
    "takeaway": "The thief captured the whole request, token and proof, and sends it again unchanged. The proof is still bound to the right key, method and URL, so only the jti replay cache stops it.",
    "talk": "\"Right key, right URL, same jti. Only the replay cache stops it.\"",
    "stolen": {
      "token": true,
      "proof": true,
      "key": false,
      "cert": false
    },
    "rfc": [
      "RFC 9449 11.1"
    ],
    "attackStep": "thief",
    "expect": {
      "status": 401,
      "error": "invalid_dpop_proof"
    },
    "blockedBy": "dpop_jti",
    "steps": [
      {
        "op": "issue",
        "id": "t1",
        "kind": "dpop",
        "holder": "client",
        "api": "a"
      },
      {
        "op": "call",
        "id": "legit",
        "who": "client",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "DPoP",
        "proof": {
          "key": "client"
        },
        "say": "{{agent}} makes the real call.",
        "expect": {
          "status": 200
        }
      },
      {
        "op": "call",
        "id": "thief",
        "who": "attacker",
        "replay": "legit",
        "say": "The thief resends the captured request, byte for byte.",
        "expect": {
          "status": 401,
          "error": "invalid_dpop_proof"
        }
      }
    ]
  },
