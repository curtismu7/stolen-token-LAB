          "error": "invalid_dpop_proof"
        }
      }
    ]
  },
  {
    "id": "S11",
    "slug": "dpop-nonce",
    "kind": "conformance",
    "title": "DPoP: server nonce required, then accepted",
    "defence": "dpop_nonce",
    "takeaway": "The gateway demands a nonce it chose, which limits how far ahead a proof can be pre-made. The first call gets 401 use_dpop_nonce plus a DPoP-Nonce header; the retry with that nonce succeeds.",
    "talk": "\"The server chooses a nonce: 401, header, retry.\"",
    "stolen": {
      "token": false,
      "proof": false,
      "key": false,
      "cert": false
    },
    "rfc": [
      "RFC 9449 8",
      "RFC 9449 9"
    ],
    "attackStep": "first",
    "expect": {
      "status": 401,
      "error": "use_dpop_nonce"
    },
    "blockedBy": "dpop_nonce",
    "steps": [
      {
        "op": "issue",
        "id": "t1",
        "kind": "dpop",
        "holder": "client",
        "api": "a"
      },
      {
        "op": "call",
        "id": "first",
        "who": "client",
        "token": "t1",
        "api": "a",
        "method": "GET",
        "path": "{{path_read}}",
        "scheme": "DPoP",
        "proof": {
          "key": "client",
          "nonce": "none"
        },
        "say": "{{agent}} sends a proof with no nonce.",
        "expect": {
          "status": 401,
          "error": "use_dpop_nonce"
